QMainWindow { 
    background-color: #212121; 
}
QLabel { 
    color: #FFFFFF; 
    font-size: 24px; 
    font-weight: bold; 
    margin-bottom: 10px; 
}
QPushButton {
    background-color: #0078D4;
    color: white;
    border-radius: 8px;
    padding: 10px;
    min-width: 150px;
}
QPushButton:hover { 
    background-color: #106EBE; 
}